# Optional overrides. Defaults match live TEB Cloud (tebsys) hosts.
NEXT_PUBLIC_TEB_MASTER_API=https://mastersv4api.tebsys.com
NEXT_PUBLIC_TEB_COMPANY_API=https://companyv4api.tebsys.com
NEXT_PUBLIC_TEB_USER_API=https://userv4api.tebsys.com
NEXT_PUBLIC_TEB_DYNAMIC_API=https://dynamicv4api.tebsys.com
NEXT_PUBLIC_TEB_TEMPLATE_API=https://templatev4api.tebsys.com
NEXT_PUBLIC_TEB_WEBCONNECT_API=https://webconnectorv4api.tebsys.com/api
NEXT_PUBLIC_TEB_MICRO_API=https://gateway.tebsys.com

# Ask GenAI analysis (server-only). Put real keys in .env.local — Next.js does not load this file.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Local diagnosis only. Put the problem login in .env.local — never commit it, never paste it in chat.
# TEB_ASK_EMAIL=
# TEB_ASK_PASSWORD=
